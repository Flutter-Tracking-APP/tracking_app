#!/bin/bash

# Exit immediately if any command fails
set -e

# ==============================================================================
# COLOR & FORMATTING DEFINITIONS
# ==============================================================================
BOLD='\033[1m'
NC='\033[0m' # No Color

# Theme Colors
CYAN='\033[0;36m'
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
DIM='\033[2m'

# Status Indicators
CHECK="${GREEN}✔${NC}"
CROSS="${RED}✖${NC}"
ARROW="${CYAN}➜${NC}"

# Start Timer
START_TIME=$(date +%s)

# ==============================================================================
# ERROR HANDLING
# ==============================================================================
trap 'on_error' ERR

on_error() {
  echo ""
  echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e "${CROSS} ${BOLD}${RED}Pre-push checks failed!${NC}"
  echo -e "${DIM}Please fix the errors above before pushing.${NC}"
  echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo ""
  exit 1
}

print_step() {
  local step_num=$1
  local title=$2
  echo ""
  echo -e "${BLUE}---------------------------------------------------------------------${NC}"
  echo -e "${ARROW} ${BOLD}Step [${step_num}/3]:${NC} ${CYAN}${title}${NC}"
  echo -e "${BLUE}---------------------------------------------------------------------${NC}"
}

# ==============================================================================
# START SCRIPT
# ==============================================================================
echo ""
echo -e "${BOLD}${CYAN}🚀 [Pre-Push Hook] Running Build Runner & Testing${NC}"

# 1. Install Dependencies
print_step "1" "Fetching Flutter Dependencies"
flutter pub get
echo -e "${CHECK} ${GREEN}Dependencies up to date.${NC}"

# 2. Generate Code
print_step "2" "Running Code Generation (build_runner)"
dart run build_runner build --delete-conflicting-outputs
echo -e "${CHECK} ${GREEN}Code generation complete.${NC}"

# 3. Unit Tests
print_step "3" "Executing Unit Tests with Coverage"
flutter test --coverage
echo -e "${CHECK} ${GREEN}All unit tests passed.${NC}"

# ==============================================================================
# SUCCESS SUMMARY
# ==============================================================================
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CHECK} ${BOLD}${GREEN}All pre-push checks passed successfully!${NC} ${DIM}(${DURATION}s)${NC}"
echo -e "${DIM}Proceeding with push...${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

exit 0